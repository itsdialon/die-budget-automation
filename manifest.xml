<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="TaskPaneApp">

  <Id>8b0f6c31-7a42-4d9e-9b51-2a6c8f3d1057</Id>
  <Version>1.0.1.0</Version>
  <ProviderName>Die-Budget</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Die-Budget Automation"/>
  <Description DefaultValue="Automatic budget management for Die-Budget."/>

  <IconUrl DefaultValue="https://itsdialon.github.io/die-budget-automation/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://itsdialon.github.io/die-budget-automation/icon-80.png"/>
  <SupportUrl DefaultValue="https://github.com/itsdialon/die-budget-automation"/>

  <AppDomains>
    <AppDomain>https://itsdialon.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ExcelApi" MinVersion="1.7"/>
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://itsdialon.github.io/die-budget-automation/index.html"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
    xsi:type="VersionOverridesV1_0">

    <Requirements>
      <Sets DefaultMinVersion="1.1">
        <Set Name="SharedRuntime" MinVersion="1.1"/>
      </Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="Workbook">
        <Runtimes>
          <Runtime resid="Taskpane.Url" lifetime="long"/>
        </Runtimes>

        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>

          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="DieBudgetTab">
              <Label resid="Tab.Label"/>
              <Group id="DieBudgetGroup">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="OpenBudget">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://itsdialon.github.io/die-budget-automation/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://itsdialon.github.io/die-budget-automation/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://itsdialon.github.io/die-budget-automation/icon-80.png"/>
      </bt:Images>

      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://itsdialon.github.io/die-budget-automation/index.html"/>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://github.com/itsdialon/die-budget-automation"/>
      </bt:Urls>

      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Die-Budget Automation"/>
        <bt:String id="Tab.Label" DefaultValue="Die-Budget"/>
        <bt:String id="Group.Label" DefaultValue="Automation"/>
        <bt:String id="Button.Label" DefaultValue="Open Automation"/>
      </bt:ShortStrings>

      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Automatically manage your Die-Budget spreadsheet."/>
        <bt:String id="Button.Description" DefaultValue="Open the automatic budget manager."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
